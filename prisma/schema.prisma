generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



model Stok {
  id            Int      @id @default(autoincrement())
  tabungIsi     Int      @default(0)
  tabungKosong  Int      @default(0)
  tabungPinjam  Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("stok")
}

model Transaksi {
  id          Int      @id @default(autoincrement())
  action      String   // "masuk", "keluar", "pinjam", "kembali"
  tipe        String   // "isi" atau "kosong"
  jumlah      Int
  keterangan  String?
  lokasi      String?  // "A", "B", "C", dst untuk gas keluar
  createdAt   DateTime @default(now())
  createdBy   String?  // User ID (opsional, untuk tracking siapa yang input)

  @@map("transaksi")
}

model TabungPinjam {
  id            Int      @id @default(autoincrement())
  namaPeminjam  String   // Nama customer yang meminjam
  tipe          String   // "isi" atau "kosong" - tipe tabung yang dipinjam
  jumlahPinjam  Int      // Jumlah tabung yang dipinjam
  jumlahKembali Int      @default(0) // Jumlah yang sudah dikembalikan
  status        String   @default("dipinjam") // "dipinjam" atau "selesai"
  catatan       String? // Catatan pinjam
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tabung_pinjam")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hash password dengan bcrypt
  nama      String
  role      String   @default("staff") // "admin" atau "staff"
  createdAt DateTime @default(now())

  @@map("users")
}